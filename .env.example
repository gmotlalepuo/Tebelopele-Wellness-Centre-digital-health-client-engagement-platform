# Public application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase browser-safe configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only Supabase access. Never expose this value to browser code.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Local interface preview only. Keep disabled in production.
TEBELOPELE_PREVIEW_MODE=0

# External Qwen 2.5 service
TEBELOPELE_AI_BASE_URL=https://your-ai-service.example.com
TEBELOPELE_AI_API_KEY=your-ai-service-api-key
TEBELOPELE_AI_TIMEOUT_MS=12000

# Optional destinations shown when a shared Supabase identity belongs to multiple apps
TEBELOPELE_EPAYMENT_URL=https://your-epayment-app.example.com
TEBELOPELE_JOBS_URL=https://your-jobs-app.example.com

# Meta WhatsApp Cloud API
WHATSAPP_PROVIDER=meta_cloud
WHATSAPP_ACCESS_TOKEN=your-system-user-access-token
WHATSAPP_APP_SECRET=your-meta-app-secret
WHATSAPP_VERIFY_TOKEN=generate-a-long-random-verification-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-whatsapp-business-account-id
WHATSAPP_GRAPH_API_VERSION=v23.0
